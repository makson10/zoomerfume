# Copy to .env and fill in: cp .env.example .env

# OpenAI
OPENAI_API_KEY=sk-...
# Transient-failure retries per model request (timeouts, 429, 5xx).
# N retries = N+1 attempts.
OPENAI_MAX_RETRIES=2
CHAT_MODEL=gpt-6-luna

# Agent runtime
# Hard ceiling on agent-loop iterations per turn.
AGENT_MAX_TURNS=15
# Feed the model only the last N user turns (older turns stay in the stored
# session). 0 disables.
HISTORY_WINDOW_TURNS=12
# Also drop turns older than N days from the model input. 0 disables.
HISTORY_RETENTION_DAYS=4

# Postgres (message log)
# Async SQLAlchemy DSN; the asyncpg driver is required. Host/user/db must match
# the POSTGRES_* values below (consumed by the compose `postgres` service).
DATABASE_URL=postgresql+asyncpg://zoomer:zoomer@postgres:5432/zoomerfume
POSTGRES_USER=zoomer
POSTGRES_PASSWORD=zoomer
POSTGRES_DB=zoomerfume
# Master switch for the message log; false makes writes a no-op.
MESSAGE_LOG_ENABLED=true

# Qdrant (matches the service name in docker-compose)
QDRANT_URL=http://qdrant:6333

# Sign-in
# Signs the session cookie. Required, at least 32 characters:
# openssl rand -hex 32
SESSION_SECRET=
# Region for phone numbers typed without a country code.
PHONE_DEFAULT_REGION=UA

# Rate limits (fixed one-minute windows, over the limit → 429)
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=10

DEBUG=false
