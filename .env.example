# Copy to .env and fill in: cp .env.example .env

# OpenAI
OPENAI_API_KEY=sk-...
# Transient-failure retries per model request (timeouts, 429, 5xx).
# N retries = N+1 attempts.
OPENAI_MAX_RETRIES=2
CHAT_MODEL=gpt-6-luna

# Agent runtime
# Hard ceiling on model calls per turn; past it Zoomer says it couldn't finish.
AGENT_MAX_TURNS=5
# Feed the model only the last N user turns (older turns stay in the stored
# session). 0 disables.
HISTORY_WINDOW_TURNS=12

# Postgres (users, conversations, agent history, message log, rate limits)
# Async SQLAlchemy DSN; the asyncpg driver is required. Host/user/db must match
# the POSTGRES_* values below (consumed by the compose `postgres` service).
DATABASE_URL=postgresql+asyncpg://zoomer:zoomer@postgres:5432/zoomerfume
POSTGRES_USER=zoomer
POSTGRES_PASSWORD=zoomer
POSTGRES_DB=zoomerfume
# Master switch for the message log; false makes writes a no-op, and the
# web chat can't restore transcripts.
MESSAGE_LOG_ENABLED=true

# Knowledge base: Qdrant (matches the service name in docker-compose), the
# corpus folder (relative to backend/, or /app in the image) and the
# embedding model. Changing the model or dimensions needs a new collection.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=kb_chunks
CORPUS_DIR=corpus
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Sign-in
# Signs the session cookie. Required, at least 32 characters:
# openssl rand -hex 32
SESSION_SECRET=
# Region for phone numbers typed without a country code.
PHONE_DEFAULT_REGION=UA

# Rate limits (fixed one-minute windows, over the limit → 429)
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=10

DEBUG=false
